{
  "manifest_version": 3,
  "name": "Test SW Extension",
  "version": "1.0",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_end"
  }]
}
